querysegments:
- name: consumer-query-segment1
  querysegment:
    data: CREATE OR REPLACE TEMP VIEW publisher_view AS SELECT * FROM publisher_data
    executionSequence: 1
    postFilterings: []
    preConditions: []
- name: consumer-query-segment2
  querysegment:
    data: CREATE OR REPLACE TEMP VIEW consumer_view AS SELECT * FROM consumer_data
    executionSequence: 1
    postFilterings: []
    preConditions: []
- name: consumer-query-segment3
  querysegment:
    data: SELECT author, COUNT(*) AS Number_Of_Mentions, SUM(mentions) AS Restricted_Sum
      FROM (SELECT * FROM publisher_view UNION ALL SELECT * FROM consumer_view) AS
      combine_data WHERE mentions LIKE '%MikeDoesBigData%' GROUP BY author ORDER BY
      Number_Of_Mentions DESC
    executionSequence: 2
    preConditions:
    - minRowCount: 100
      viewName: publisher_view
    - minRowCount: 100
      viewName: consumer_view
    postFilterings:
    - columnName: Number_Of_Mentions
      value: 2
